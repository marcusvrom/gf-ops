[Unit]
Description=Prometheus postgres_exporter
Documentation=https://github.com/prometheus-community/postgres_exporter
After=postgresql.service
# Wants= (não Requires=) — exporter sobe mesmo se PG demorar; ele só não exporta
# até o PG aparecer. NÃO bloqueia gf.target.
Wants=postgresql.service

[Service]
Type=simple
User=pg_exporter
Group=pg_exporter
EnvironmentFile=/etc/gf-server/exporter.env
ExecStart=/usr/local/bin/postgres_exporter --web.listen-address=127.0.0.1:9187
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=postgres-exporter

[Install]
WantedBy=multi-user.target
