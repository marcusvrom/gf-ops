# /etc/gf-server/env — extensão para backup off-site.
# Acrescente estes campos ao /etc/gf-server/env existente (criado em ops/install/).
#
# Pelo menos UM dos GF_BACKUP_* deve estar setado — senão o backup só fica local.

# Diretório local onde os dumps ficam antes de partir.
GF_BACKUP_DIR='/var/backups/gf-server'

# Retenção LOCAL (em dias). Off-site tem retenção própria no destino.
GF_BACKUP_RETAIN_DAYS='14'

# Modo 1: rsync-over-SSH. user@host:/path/absoluto/
# Exemplo: 'gfbackup@nas.local:/srv/backups/gf-server/'
# Pré-req: chave SSH do root local autorizada no destino, conexão funciona sem prompt.
GF_BACKUP_SSH=''

# Modo 2: rclone. 'remote:bucket/prefixo'
# Exemplo: 'b2:meu-bucket/gf-server/' ou 's3:backups/gf/'
# Pré-req: rclone configurado em /root/.config/rclone/rclone.conf.
GF_BACKUP_RCLONE=''

# Hostname identificador do origem (vai no manifest). Default: hostname -s.
GF_BACKUP_TAG=''
