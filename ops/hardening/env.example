# /etc/gf-server/env — extensão para hardening.
# Acrescente estas chaves ao /etc/gf-server/env existente. .example é versionado;
# o env real (com a senha) é root:root 0600 e gitignored.
#
# Gere senhas fortes (ex.: openssl rand -base64 32 | tr -d '+/=' | cut -c1-32).
# Não use a mesma senha das duas roles — perdem o ponto do isolamento.

# Role usada pelos binários do jogo (WorldServer/LoginServer/MissionServer/
# GatewayServer). Substituida no setup.ini e GatewayServer/setup.ini.
GF_GAME_DB_PASSWORD='CHANGEME_GAME_STRONG_RANDOM'

# Role usada pelo painel reescrito (web/). Substituida em
# /var/www/gf-panel/config.local.php.
GF_PANEL_DB_PASSWORD='CHANGEME_PANEL_STRONG_RANDOM'

# Compat: GF_DB_PASSWORD e GF_DB_USER (gf_app) ainda existem como PONTE até
# que run-hardening.sh tenha trocado os consumidores e você rode
# rollback.sh --retire-gf-app explicitamente. Mantenha por enquanto.
