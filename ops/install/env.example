# /etc/gf-server/env — segredo do install hardened.
# Copie para /etc/gf-server/env, ajuste os valores e:
#   sudo chown root:root /etc/gf-server/env
#   sudo chmod 600       /etc/gf-server/env
#
# Esses scripts (e o painel reescrito, via getenv) leem daqui.

# Senha do role 'gf_app' no PostgreSQL (NÃO use a senha do postgres superuser).
GF_DB_PASSWORD='troque-isto-por-algo-forte'

# IP do servidor exposto ao cliente. Esse é o que será GRAVADO nos binários
# (WorldServer/ZoneServer offsets 0x3EA7A7 / 0x822D47) e nos bancos
# (gf_ls.worlds.ip, gf_gs.serverstatus.ext_address).
# Em VM isolada/LAN, use o IP da interface da VM, NÃO 127.0.0.1.
GF_SERVER_HOST_IP='192.0.2.10'

# Diretório dos binários do server file (GameServer).
GF_SERVER_ROOT='/root/gf_server'

# Diretório dos dumps .sql do schema (gf_gs.sql, gf_ls.sql, gf_ms.sql).
GF_SQL_DIR='/root/gf_server/_utils/db'

# Host do PostgreSQL (sempre localhost no install hardened).
GF_DB_HOST='127.0.0.1'
GF_DB_PORT='5432'
GF_DB_USER='gf_app'

# --- Hardening (ops/hardening/) ---
# Após o install inicial, o hardening cria DUAS roles com privilégio mínimo
# e reescreve setup.ini / config.local.php. Defina estas senhas ANTES de
# rodar ops/hardening/run-hardening.sh. Veja também ops/hardening/env.example.
# Use senhas DIFERENTES entre as duas para o isolamento ter efeito.
GF_GAME_DB_PASSWORD='CHANGEME_GAME_STRONG_RANDOM'
GF_PANEL_DB_PASSWORD='CHANGEME_PANEL_STRONG_RANDOM'
