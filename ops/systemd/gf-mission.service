[Unit]
Description=Grand Fantasia MissionServer
Documentation=https://github.com/marcusvrom/gf-ops
After=gf-login.service
Requires=gf-login.service

[Service]
Type=simple
WorkingDirectory=/root/gf_server/MissionServer
ExecStart=/root/gf_server/MissionServer/MissionServer
Environment=LC_ALL=C
Environment=LANG=C
Environment=LANGUAGE=C
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gf-mission

[Install]
WantedBy=gf.target
